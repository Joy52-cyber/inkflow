# Copy to .env and fill in. .env is gitignored — never commit real keys.

# AI provider for localization (Claude works today; Gemini optional)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Which model the localizer uses: claude | gemini
LOCALIZE_MODEL=claude

# Postgres (Phase 2). Example: postgresql://postgres:password@localhost:5432/inkflow
DATABASE_URL=
# Set true for managed Postgres that requires SSL (e.g. Railway)
PGSSL=false

# Auth (Phase 2)
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Page-image storage (Phase 2.5). Leave S3_* blank to use the local filesystem.
# For Cloudflare R2: endpoint = https://<accountid>.r2.cloudflarestorage.com, region = auto
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL objects are served from (R2 public bucket or custom domain)
S3_PUBLIC_BASE_URL=

# API server port
PORT=3001
